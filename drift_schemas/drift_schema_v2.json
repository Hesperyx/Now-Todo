  "fixed_sql": [
    {
      "name": "task_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NULL, \"is_built_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_built_in\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurrence_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurrence_rules\" (\"id\" TEXT NOT NULL, \"frequency\" INTEGER NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1, \"by_weekday\" TEXT NULL, \"by_month_day\" TEXT NULL, \"end_date\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"due_date\" INTEGER NULL, \"due_date_has_time\" INTEGER NOT NULL DEFAULT 0 CHECK (\"due_date_has_time\" IN (0, 1)), \"priority\" INTEGER NOT NULL DEFAULT 0, \"status\" INTEGER NOT NULL DEFAULT 0, \"list_id\" TEXT NULL REFERENCES task_lists (id) ON DELETE SET NULL, \"recurrence_rule_id\" TEXT NULL REFERENCES recurrence_rules (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "task_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_tags\" (\"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"task_id\", \"tag_id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"is_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_done\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"remind_at\" INTEGER NOT NULL, \"repeat_type\" INTEGER NOT NULL DEFAULT 0, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"theme_mode\" INTEGER NOT NULL DEFAULT 0, \"default_view\" INTEGER NOT NULL DEFAULT 0, \"notifications_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"notifications_enabled\" IN (0, 1)), \"strong_reminders\" INTEGER NOT NULL DEFAULT 0 CHECK (\"strong_reminders\" IN (0, 1)), \"initialized_at\" INTEGER NULL, \"updated_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
